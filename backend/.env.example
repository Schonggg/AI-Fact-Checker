# ================================================
# AI Fact Checker Backend - Environment Variables
# ================================================
# 复制此文件为 .env 并填写实际值
# 队员 1 使用

# ── 🌟 Gonka Router（必须）- 比赛期间免费 Token ──
# 从 gonkarouter.io 获取 API Key
GONKA_API_KEY=your_gonka_api_key_here
GONKA_BASE_URL=https://gonkarouter.io/v1

# ── 🔍 实时搜索 API（推荐至少一个） ───────────────
# Tavily (推荐) - https://tavily.com （有免费额度）
TAVILY_API_KEY=your_tavily_api_key_here

# Serper (备选) - https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# ── 🖥️ 服务器配置 ────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ── 🌐 前端 URL（用于 CORS） ────────────────────
# 开发环境
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# 生产环境请替换为实际前端 URL
# ALLOWED_ORIGINS=https://your-frontend.com

# ── 📝 日志级别 ──────────────────────────────────
LOG_LEVEL=INFO