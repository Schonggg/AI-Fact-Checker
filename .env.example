# ──────────────────────────────────────────────────────────────────
# AI Fact Checker — Environment Variables
# Copy this file to `.env.local` for local dev (python server.py)
# OR set the same keys in Vercel → Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────
# Gonka Router API key (the OpenAI-compatible multi-model broker).
# Get it at https://gonkarouter.io. Without this, POST /api/verify returns 503.
GONKA_API_KEY=

# ── RECOMMENDED ──────────────────────────────────────────────────
# Tavily search key for real-time "background facts" retrieval.
# Without it, fact-checking still runs but without live web evidence.
# Free tier: https://tavily.com
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# ── OPTIONAL — Gonka Router endpoint ─────────────────────────────
# Defaults to the public Gonka broker. Override only if you use a private gateway.
GONKA_BASE_URL=https://api.gonkarouter.io/v1

# ── OPTIONAL — Model selection (defaults match the hackathon config) ──
GONKA_DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
GONKA_KIMI_MODEL=moonshotai/Kimi-K2.6
GONKA_MINIMAX_MODEL=MiniMaxAI/MiniMax-M2.7
GONKA_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# ── OPTIONAL — Timeouts & budget (seconds) ───────────────────────
# Keep GONKA_TOTAL_BUDGET_SECONDS <= Vercel function maxDuration (60).
GONKA_MODEL_TIMEOUT=45
GONKA_KIMI_MODEL_TIMEOUT=30
GONKA_ARTICLE_TIMEOUT=15
GONKA_TOTAL_BUDGET_SECONDS=50

# ── OPTIONAL — CORS / logging ────────────────────────────────────
# Origin allowed by the API. "*" works for same-origin Vercel deploys.
# Set a specific origin (e.g. https://your-app.vercel.app) to lock it down.
GONKA_ALLOWED_ORIGIN=*
LOG_LEVEL=INFO

# ── Blockchain / Smart Contracts ──────────────────────────────
TRUTH_REGISTRY_ADDRESS=0xb0DeedAe473dc32DD2B69bFdEc554e3b34119c58
MICRO_BOUNTY_ADDRESS=0xb391DB173D6211e246b174F91E790662C5Bb9a24
CHAIN_ID=421614